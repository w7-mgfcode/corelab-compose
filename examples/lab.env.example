# corelab — sample lab values.
# Copy it to the repo root as lab.env and fill in your own lab's values.
# lab.env never goes into Git (.gitignore). The sample addresses come from the
# RFC 5737 documentation range; they are not real addresses.

# app-01 (Fedora CoreOS VM) address on the lab network; the original destination in the DOCKER-USER rule
VM_ADDR=192.0.2.10
# app-01 external network interface (Proxmox virtio NIC; check on first boot: ip -br link)
EXT_IF=ens18
# Admin source: SSH (22) and ping only from here
ADMIN_SRC=192.0.2.50/32
# Clients that may reach port 443 (app.corelab.test, logs.corelab.test)
CLIENT_NET=192.0.2.50/32
# Source address of the Checkmk server (ext-01): agent (6556), ping and 443
CHECKMK_SRC=192.0.2.20/32
# Address of the SMTP relay (Mailpit on ext-01); Postfix reaches it as relay.corelab.test
RELAY_ADDR=192.0.2.20
# The admin's public SSH key (~ is expanded); it is given to the core user
ADMIN_PUBKEY_FILE=~/.ssh/id_ed25519.pub
