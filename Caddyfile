# corelab — Caddy: HTTPS termination with the internal CA (tls internal), for two names.
# Port 80 is not published, and there is no HTTP->HTTPS redirect.
# The access log goes to a file as JSON lines (caddy_logs volume); Alloy reads it from there.
{
	auto_https disable_redirects
}

(lab) {
	tls internal
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}

app.corelab.test {
	import lab
	reverse_proxy wordpress:80
}

logs.corelab.test {
	import lab
	reverse_proxy grafana:3000
}
